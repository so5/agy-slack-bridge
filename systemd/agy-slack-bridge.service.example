# Example only: tools/install.py generates <prefix>/systemd/agy-slack-bridge.service
# with the real paths filled in - use that one. This shows the shape for a
# default install (prefix ~/.local/share/agy-slack-bridge).
#
#   cp <prefix>/systemd/agy-slack-bridge.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agy-slack-bridge.service
#
# loginctl enable-linger <user> beforehand if you want it to survive logout /
# start on boot without an active login session.

[Unit]
Description=Slack <-> Antigravity CLI (agy) bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/agy-slack-bridge
EnvironmentFile=%h/.config/agy-slack-bridge/env
Environment=AGY_BRIDGE_CONFIG=%h/.config/agy-slack-bridge/config.yaml
Environment=AGY_BRIDGE_STATE_DB=%h/.config/agy-slack-bridge/state.sqlite3
ExecStart=%h/.local/share/agy-slack-bridge/.venv/bin/python %h/.local/share/agy-slack-bridge/bridge.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
