# Copy to a private location, e.g. ~/.config/agy-slack-bridge/env (chmod 600),
# and reference it from the systemd unit via EnvironmentFile=.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Optional overrides (defaults shown):
# AGY_BRIDGE_CONFIG=/home/you/.config/agy-slack-bridge/config.yaml
# AGY_BRIDGE_STATE_DB=/home/you/.config/agy-slack-bridge/state.sqlite3
# AGY_BIN=agy
# AGY_TIMEOUT_SEC=1200
# AGY_SETTINGS_PATH=/home/you/.gemini/antigravity-cli/settings.json
# AGY_TEMP_GRANT_MAX_AGE_SEC=3600
# AGY_TEMP_GRANT_SWEEP_INTERVAL_SEC=300
# AGY_CONFIG_BACKUP_DIR=/home/you/.config/agy-slack-bridge/config-backups
# AGY_CONFIG_DRIFT_CHECK_INTERVAL_SEC=1800
# LOG_LEVEL=INFO
